{
  "name": "pdf.ly",
  "version": "2.0.0",
  "description": "PDF.ly is an AI-powered tool for querying and interacting with documents using natural language.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev:server": "tsx watch index.ts",
    "dev:worker": "tsx watch worker.ts",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:worker\"",
    "build": "tsup index.ts worker.ts --format esm --clean",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start": "pnpm prisma generate && concurrently \"pnpm start:server\" \"pnpm start:worker\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "Sourav Kumar Agarwal",
  "license": "ISC",
  "dependencies": {
    "@clerk/express": "^2.1.26",
    "@langchain/core": "^1.1.49",
    "@langchain/pinecone": "^1.0.3",
    "@langchain/textsplitters": "^1.0.1",
    "@openrouter/sdk": "^0.13.7",
    "@pinecone-database/pinecone": "^5.1.2",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "body-parser": "^2.2.2",
    "bullmq": "^5.78.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "prisma": "^7.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
